  "description": "A library to keep track of architectural decisions with PHP annotations.",
  "license": ["MIT"],
  "require": {
    "php": "^8.3",
    "phpdocumentor/reflection-docblock": "^6.0"
  },
  "require-dev": {
    "cspray/assert-throws": "^0.2",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
